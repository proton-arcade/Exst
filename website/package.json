{
  "name": "exst-arcade",
  "version": "3.0.0",
  "private": true,
  "description": "A file://-friendly browser arcade: open ../index.html and play. Add games by dropping files into games/ and adding one catalog block.",
  "scripts": {
    "start": "python3 -m http.server 3000 --bind 0.0.0.0 --directory ..",
    "test": "node --test tests/catalog.test.cjs tests/structure.test.cjs",
    "test:browser": "node tests/browser.cjs"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0"
  }
}
